rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVE GLOBAL HELPERS ---
    function isSignedIn() {
      return true;
    }

    // --- ENTITY SCHEMA VALIDATIONS ---
    function isOwner(email) {
      return true;
    }

    function isLevel4() {
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    // --- ENTITY SCHEMA VALIDATIONS ---
    function isValidMember(data) {
      return data.id is string && data.id.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.dob is string && data.dob.size() <= 10 &&
             data.position is string && data.position.size() > 0 && data.position.size() <= 150 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.createdAt is string;
    }

    function isValidCourse(data) {
      return data.id is string && data.id.size() > 0 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.category is string && data.category.size() > 0 &&
             data.level is string && data.level.size() > 0 &&
             data.description is string && data.description.size() <= 2000 &&
             data.durationDays is int && data.durationDays > 0;
    }

    function isValidSession(data) {
      return data.id is string && data.id.size() > 0 &&
             data.courseId is string && data.courseId.size() > 0 &&
             data.startDate is string && data.startDate.size() == 10 &&
             data.endDate is string && data.endDate.size() == 10 &&
             data.startTime is string && data.startTime.size() == 5 &&
             data.endTime is string && data.endTime.size() == 5 &&
             data.instructor is string && data.instructor.size() > 0 &&
             data.classroom is string && data.classroom.size() > 0 &&
             data.maxCapacity is int && data.maxCapacity > 0 &&
             data.enrolledIds is list;
    }

    function isValidTask(data) {
      return data.id is string && data.id.size() > 0 &&
             data.assignedBy is string && data.assignedBy.size() > 0 &&
             data.assignedTo is string && data.assignedTo.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.dueDate is string && data.dueDate.size() == 10 &&
             data.status is string && (data.status == "Pending" || data.status == "In Progress" || data.status == "Completed") &&
             data.createdAt is string;
    }

    // --- PATHMATCH ENTITIES ---

    // Members collection
    match /members/{memberEmail} {
      allow read: if isSignedIn();
      allow create: if isLevel4() && isValidId(memberEmail) && isValidMember(request.resource.data);
      allow update: if isSignedIn() && (
        isLevel4() || (
          isOwner(resource.data.email) &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.authorizedLevel == resource.data.authorizedLevel &&
          isValidMember(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'dob', 'avatar', 'phone', 'password'])
        )
      );
      allow delete: if isLevel4();
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update: if isLevel4() && isValidId(courseId) && isValidCourse(request.resource.data);
      allow delete: if isLevel4();
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isLevel4() && isValidId(sessionId) && isValidSession(request.resource.data);
      allow update: if isSignedIn() && (
        isLevel4() || (
          isValidSession(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledIds'])
        )
      );
      allow delete: if isLevel4();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isLevel4() && isValidId(taskId) && isValidTask(request.resource.data);
      allow update: if isSignedIn() && (
        isLevel4() || (
          isOwner(resource.data.assignedTo) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          isValidTask(request.resource.data)
        )
      );
      allow delete: if isLevel4();
    }
  }
}
