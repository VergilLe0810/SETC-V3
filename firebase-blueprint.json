{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "System personnel and safety centre members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "dob": { "type": "string" },
        "position": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "avatar": { "type": "string" },
        "phone": { "type": "string" },
        "authorizedLevel": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["id", "name", "dob", "position", "email", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Safety & environment courses offered by the centre",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "description": { "type": "string" },
        "syllabus": { "type": "array" },
        "durationDays": { "type": "integer" },
        "certificationEarned": { "type": "string" },
        "domain": { "type": "string" }
      },
      "required": ["id", "code", "title", "category", "level", "description", "durationDays", "certificationEarned"]
    },
    "CourseSession": {
      "title": "CourseSession",
      "description": "Offering sessions of specific courses with classroom, date and instructor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "instructor": { "type": "string" },
        "classroom": { "type": "string" },
        "maxCapacity": { "type": "integer" },
        "enrolledIds": { "type": "array" },
        "taOfficer": { "type": "string" },
        "tgOfficer": { "type": "string" },
        "method": { "type": "string" },
        "notes": { "type": "string" },
        "domain": { "type": "string" }
      },
      "required": ["id", "courseId", "startDate", "endDate", "startTime", "endTime", "instructor", "classroom", "maxCapacity", "enrolledIds"]
    },
    "Task": {
      "title": "Task",
      "description": "Task/assignment delegated to personnel members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assignedBy": { "type": "string" },
        "assignedTo": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "sessionId": { "type": "string" },
        "courseName": { "type": "string" },
        "assignedRole": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "taOfficer": { "type": "string" },
        "tgOfficer": { "type": "string" },
        "method": { "type": "string" },
        "instructor": { "type": "string" }
      },
      "required": ["id", "assignedBy", "assignedTo", "title", "description", "dueDate", "status", "createdAt"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "All personnel directory and members profile definitions"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "All training academy course definitions"
    },
    "/sessions/{sessionId}": {
      "schema": "CourseSession",
      "description": "Course session offerings and enrollments"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Task and system notifications assigned to personnel"
    }
  }
}
